APP_NAME=Iris
DEEPSEEK_API_KEY=your_deepseek_api_key
# Deprecated compatibility alias; prefer DEEPSEEK_API_KEY.
# API_KEY=
CODING_API_KEY=your_coding_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
SQLITE_PATH=data/neuroasist.sqlite3
# Desktop sets this automatically. Uncomment only to isolate development data.
# NEUROASIST_APP_DATA_DIR=C:\path\to\iris-data
BACKUP_RETENTION_DAYS=30
# Set only by the Tauri shell. Leave empty for the existing browser/dev workflow.
# NEUROASIST_DESKTOP_TOKEN=
CHAT_HISTORY_LIMIT=20
TIMELINE_V2_ENABLED=true
EPISODES_ENABLED=true
EPISODE_SOFT_INACTIVITY_MINUTES=20
EPISODE_HARD_INACTIVITY_MINUTES=60
EPISODE_MAXIMUM_MESSAGES=120
EPISODE_MAXIMUM_ESTIMATED_TOKENS=16000
CONTEXT_MANAGER_ENABLED=true
CONVERSATION_DIAGNOSTICS_ENABLED=false
CONTEXT_MAX_TOKENS=3000
CONTEXT_RECENT_TURNS=8
# off | balanced | automatic. Balanced saves only high-confidence durable facts;
# sensitive candidates always require confirmation by default.
MEMORY_ENABLED=true
MEMORY_MODE=balanced
MEMORY_SENSITIVE_MODE=ask
MEMORY_MAX_CANDIDATES_PER_TURN=3
MEMORY_CONTEXT_MAX_TOKENS=900
# The visible reply stays fast. Eligible user turns are novelty-gated and
# coalesced into a durable background DeepSeek consolidation job.
MEMORY_LLM_EXTRACTION_ENABLED=true
MEMORY_LLM_MIN_CONFIDENCE=0.70
MEMORY_ASYNC_EXTRACTION_ENABLED=true
MEMORY_AUTO_MIN_CONFIDENCE=0.85
MEMORY_AUTO_MIN_IMPORTANCE=0.60
# ChromaDB semantic retrieval. Its rebuildable index is stored in data/chroma by default.
SEMANTIC_RETRIEVAL_ENABLED=true
SEMANTIC_RETRIEVAL_EVAL_PASSED=true
SEMANTIC_VECTOR_BACKEND=chroma
# SEMANTIC_CHROMA_PATH=data/chroma
SEMANTIC_EMBEDDING_PROVIDER=hash
SEMANTIC_EMBEDDING_MODEL_ID=hash-multilingual-v1
SEMANTIC_EMBEDDING_DIMENSION=256
# Optional pinned local E5 snapshot. Hash embeddings remain the portable default.
SEMANTIC_E5_MODEL_PATH=
SEMANTIC_E5_REVISION=
SEMANTIC_RETRIEVAL_LIMIT=8
DEEPSEEK_MODEL=deepseek-v4-flash
# Hard output ceilings. Non-coding DeepSeek calls also force thinking=disabled.
LLM_CHAT_JSON_MAX_TOKENS=900
LLM_CHAT_LIVE_MAX_TOKENS=500
LLM_MEMORY_MAX_TOKENS=1000
LLM_REFLECTION_MAX_TOKENS=300
LLM_ADJUDICATION_MAX_TOKENS=350
LLM_CODING_MAX_TOKENS=8192
# V1.0 Coding Agent
CODING_AGENT_ENABLED=true
CODING_BASE_URL=https://api.deepseek.com
CODING_DOCKER_IMAGE=neuroasist-coding
# Default workspace is a CodingAgentWorkspace sibling of this checkout.
CODING_WORKSPACE_ROOT=
# Comma-separated project roots allowed as explicit snapshot/apply targets.
CODING_ALLOWED_PROJECT_ROOTS=
CODING_MAX_CONCURRENT_TASKS=1
CODING_MAX_ITERATIONS=48
CODING_MAX_FILES=10000
CODING_MAX_TOTAL_BYTES=128000000
CODING_MAX_FILE_BYTES=500000
CODING_MAX_OUTPUT_BYTES=200000
CODING_MAX_PATCH_BYTES=600000
CODING_COMMAND_TIMEOUT_SECONDS=180
CODING_LLM_TIMEOUT_SECONDS=180
CODING_MEMORY_MB=2048
CODING_CPUS=2
CODING_PIDS_LIMIT=128
CODING_WORKSPACE_RETENTION_DAYS=14
CODING_ALLOWED_EXTENSIONS=.py,.pyi,.ts,.tsx,.js,.jsx,.json,.toml,.yaml,.yml,.md,.txt,.css,.html,.rs,.cs,.ini,.cfg
LOG_LEVEL=WARNING
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
VOICE_STT_PROVIDER=gigaam
VOICE_STT_MODEL=v3_rnnt
VOICE_STT_FALLBACK_PROVIDER=
VOICE_STT_FALLBACK_MODEL=
VOICE_STT_FALLBACK_CONFIDENCE_THRESHOLD=0.60
VOICE_STT_FALLBACK_MIN_RMS=0.008
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_TORCH_CPU_THREADS=4
VOICE_TORCH_INTEROP_THREADS=1
VOICE_STT_TERMS_PATH=
VOICE_DEFAULT_LANGUAGE=ru
VOICE_PRELOAD_STT_MODEL=true
VOICE_PRELOAD_TTS_MODEL=true
VOICE_TTS_ENABLED=true
VOICE_TTS_PROVIDER=teratts
VOICE_TERATTS_MODEL=TeraSpace/TeraTTSv2
VOICE_TERATTS_REVISION=f05ea799094571a3553904a555df3834fb0b963b
# Optional local snapshot directory for offline startup. Otherwise Hugging Face downloads once into app data.
VOICE_TERATTS_MODEL_PATH=
VOICE_TERATTS_CACHE_DIR=
VOICE_TERATTS_VOICE=ru_f1
VOICE_TERATTS_DEVICE=cpu
VOICE_TERATTS_THREADS=8
VOICE_TERATTS_DIFFUSION_MODEL=distilled
VOICE_TERATTS_RUACCENT_MODE=full
VOICE_TERATTS_RUSSIAN_STRESS=true
VOICE_TERATTS_CHUNK_FRAMES=16
VOICE_TERATTS_SEED=1234
VOICE_TERATTS_WARMUP=true
VOICE_TERATTS_TIMEOUT_SECONDS=45
# Optional JSON pronunciation dictionary; defaults to %LOCALAPPDATA%\NeuroAsist\tts-pronunciations.json.
VOICE_TTS_PRONUNCIATION_DICTIONARY_PATH=
# WAV cleanup: DC removal, 60 Hz high-pass, anti-click fades, loudness/peak safety.
VOICE_TTS_POSTPROCESSING_ENABLED=true
VOICE_TTS_LOUDNESS_TARGET_DBFS=-18
VOICE_TTS_PEAK_CEILING_DBFS=-1
VOICE_TTS_HIGHPASS_CUTOFF_HZ=60
# Style and emotion are translated to TeraTTS duration_scale; punctuation remains model-native prosody.
VOICE_TTS_ADAPTIVE_PROSODY=true
VOICE_TTS_BACKGROUND_TIMEOUT_SECONDS=120
VOICE_TTS_MAX_CHARS=1200
VOICE_AUDIO_DIR=data/audio
VOICE_MAX_UPLOAD_MB=25
VOICE_MAX_RECORD_SECONDS=60
VOICE_STT_TIMEOUT_SECONDS=45
VOICE_LLM_TIMEOUT_SECONDS=45
VOICE_TTS_TIMEOUT_SECONDS=45
VOICE_LIVE_QUEUE_SIZE=3
VOICE_LIVE_IDLE_FLUSH_MS=500
VOICE_LIVE_FIRST_IDLE_FLUSH_MS=120
VOICE_LIVE_NEXT_IDLE_FLUSH_MS=250
VOICE_LIVE_PLAYBACK_START_LEAD_MS=30
VOICE_LIVE_FIRST_SEGMENT_CHARS=32
VOICE_LIVE_NEXT_SEGMENT_CHARS=75
VOICE_LIVE_MAX_SEGMENT_CHARS=110
VOICE_LIVE_MAX_SEGMENT_WORDS=18
# Keep a full short thought in one synthesis request; lower only for weak hardware.
VOICE_LIVE_SAFE_SEGMENT_WORDS=18
VOICE_LIVE_TTS_RETRY_COUNT=0
VOICE_LIVE_TTS_CONCURRENCY_MODE=1
VOICE_LIVE_TTS_CONCURRENCY_MIN=1
VOICE_LIVE_TTS_CONCURRENCY_MAX=2
VOICE_LIVE_PLAYBACK_PREBUFFER_SEGMENTS=1
VOICE_LIVE_PLAYBACK_PREBUFFER_MS=0
VOICE_VAD_PROVIDER=silero
# Deprecated alias retained for older .env files; start/end thresholds below are authoritative.
VOICE_VAD_THRESHOLD=0.55
# Optional override. A failed override falls back to the packaged silero-vad model.
# VOICE_SILERO_VAD_MODEL_PATH=models/silero_vad.jit
VOICE_SILERO_VAD_START_THRESHOLD=0.55
VOICE_SILERO_VAD_END_THRESHOLD=0.35
VOICE_ENERGY_VAD_START_RMS=0.018
VOICE_ENERGY_VAD_END_RMS=0.012
VOICE_SILERO_VAD_MIN_SPEECH_MS=64
VOICE_ENERGY_VAD_MIN_SPEECH_MS=120
VOICE_VAD_PRE_ROLL_MS=900
VOICE_VAD_POST_ROLL_MS=180
VOICE_VAD_END_SILENCE_MS=720
VOICE_VAD_LIVE_END_SILENCE_MS=750
VOICE_VAD_LIVE_FALLBACK_END_SILENCE_MS=1100
VOICE_INPUT_DIAGNOSTIC_AUDIO=false
VOICE_INPUT_DIAGNOSTIC_DIR=
AVATAR_ENABLED=true
AVATAR_EMOTION_MAPPING_PATH=apps/protocol/avatar-emotion-mapping.json
AVATAR_HEARTBEAT_INTERVAL_SECONDS=15
AVATAR_CLIENT_TIMEOUT_SECONDS=45
