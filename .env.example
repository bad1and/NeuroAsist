DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
SQLITE_PATH=data/neuroasist.sqlite3
# Set only by the Tauri shell. Leave empty for the existing browser/dev workflow.
# NEUROASIST_DESKTOP_TOKEN=
CHAT_HISTORY_LIMIT=20
TIMELINE_V2_ENABLED=true
EPISODES_ENABLED=true
EPISODE_SOFT_INACTIVITY_MINUTES=20
EPISODE_HARD_INACTIVITY_MINUTES=60
EPISODE_MAXIMUM_MESSAGES=120
EPISODE_MAXIMUM_ESTIMATED_TOKENS=16000
CONTEXT_MANAGER_ENABLED=true
CONTEXT_MAX_TOKENS=3000
CONTEXT_RECENT_TURNS=8
# off | ask | automatic. Sensitive candidates always require confirmation by default.
MEMORY_ENABLED=true
MEMORY_MODE=ask
MEMORY_SENSITIVE_MODE=ask
MEMORY_MAX_CANDIDATES_PER_TURN=3
MEMORY_CONTEXT_MAX_TOKENS=900
# One DeepSeek response returns reply plus memory candidates. No local LLM is used.
MEMORY_LLM_EXTRACTION_ENABLED=true
MEMORY_LLM_MIN_CONFIDENCE=0.70
# ChromaDB semantic retrieval. Its rebuildable index is stored in data/chroma by default.
SEMANTIC_RETRIEVAL_ENABLED=true
SEMANTIC_RETRIEVAL_EVAL_PASSED=true
SEMANTIC_VECTOR_BACKEND=chroma
# SEMANTIC_CHROMA_PATH=data/chroma
SEMANTIC_EMBEDDING_PROVIDER=hash
SEMANTIC_EMBEDDING_MODEL_ID=hash-multilingual-v1
SEMANTIC_EMBEDDING_DIMENSION=256
SEMANTIC_RETRIEVAL_LIMIT=8
DEEPSEEK_MODEL=deepseek-v4-flash
LOG_LEVEL=WARNING
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
VOICE_STT_PROVIDER=gigaam
VOICE_STT_MODEL=v3_rnnt
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_DEFAULT_LANGUAGE=ru
VOICE_PRELOAD_STT_MODEL=true
VOICE_PRELOAD_TTS_MODEL=true
VOICE_TTS_ENABLED=true
VOICE_TTS_PROVIDER=supertonic
VOICE_TTS_FALLBACK_PROVIDER=silero
VOICE_SUPERTONIC_MODEL=supertonic-3
VOICE_SUPERTONIC_VOICE=F4
# Empty uses %LOCALAPPDATA%/NeuroAsist/models/supertonic-3.
VOICE_SUPERTONIC_CACHE_DIR=
VOICE_SUPERTONIC_TOTAL_STEPS=8
VOICE_SUPERTONIC_SPEED=1.05
VOICE_SUPERTONIC_CPU_THREADS=8
VOICE_SUPERTONIC_WARMUP=true
VOICE_SUPERTONIC_AUTO_DOWNLOAD=true
VOICE_SUPERTONIC_TIMEOUT_SECONDS=15
VOICE_SUPERTONIC_INTER_SEGMENT_SILENCE_MS=60
VOICE_SUPERTONIC_TRIM_SILENCE=true
VOICE_SUPERTONIC_LEADING_PADDING_MS=70
VOICE_SUPERTONIC_TRAILING_PADDING_MS=110
VOICE_SILERO_MODEL=v5_5_ru
VOICE_SILERO_SPEAKER_RU=xenia
VOICE_SILERO_SAMPLE_RATE=24000
VOICE_SILERO_DEVICE=cpu
VOICE_SILERO_CPU_THREADS=4
VOICE_SILERO_WARMUP=true
VOICE_SILERO_TIMEOUT_SECONDS=10
VOICE_SILERO_NATIVE_ENGLISH=false
VOICE_SILERO_ENGLISH_MODEL=v3_en
VOICE_SILERO_ENGLISH_SPEAKER=en_0
VOICE_CMUDICT_ENABLED=true
VOICE_CMUDICT_CACHE_DIR=.cache/cmudict
# Optional CPU-only tone conversion. Full TTS uses about 1.5-2 GB RAM, no GPU VRAM.
VOICE_OPENVOICE_ENABLED=false
VOICE_OPENVOICE_REFERENCE_AUDIO=
VOICE_OPENVOICE_CACHE_DIR=.cache/openvoice-v2
VOICE_OPENVOICE_REPO_ID=myshell-ai/OpenVoiceV2
VOICE_OPENVOICE_REVISION=fd981100305a0e4291f93a9ad169c6d9f7bed54a
VOICE_OPENVOICE_TAU=0.3
VOICE_OPENVOICE_CPU_THREADS=8
VOICE_TTS_BACKGROUND_TIMEOUT_SECONDS=120
VOICE_TTS_MAX_CHARS=1200
VOICE_AUDIO_DIR=data/audio
VOICE_MAX_UPLOAD_MB=25
VOICE_MAX_RECORD_SECONDS=60
VOICE_STT_TIMEOUT_SECONDS=45
VOICE_LLM_TIMEOUT_SECONDS=45
VOICE_TTS_TIMEOUT_SECONDS=45
VOICE_LIVE_QUEUE_SIZE=3
VOICE_LIVE_IDLE_FLUSH_MS=500
VOICE_LIVE_FIRST_SEGMENT_CHARS=32
VOICE_LIVE_NEXT_SEGMENT_CHARS=75
VOICE_LIVE_MAX_SEGMENT_CHARS=110
VOICE_LIVE_MAX_SEGMENT_WORDS=18
VOICE_LIVE_SAFE_SEGMENT_WORDS=10
VOICE_LIVE_TTS_RETRY_COUNT=0
VOICE_LIVE_TTS_CONCURRENCY_MODE=1
VOICE_LIVE_TTS_CONCURRENCY_MIN=1
VOICE_LIVE_TTS_CONCURRENCY_MAX=2
VOICE_LIVE_PLAYBACK_PREBUFFER_SEGMENTS=1
VOICE_LIVE_PLAYBACK_PREBUFFER_MS=0
VOICE_VAD_PROVIDER=silero
# Optional local Silero TorchScript VAD model (.jit). Missing model uses safe energy fallback.
# VOICE_SILERO_VAD_MODEL_PATH=models/silero_vad.jit
VOICE_VAD_THRESHOLD=0.55
VOICE_VAD_PRE_ROLL_MS=500
AVATAR_ENABLED=true
AVATAR_HEARTBEAT_INTERVAL_SECONDS=15
AVATAR_CLIENT_TIMEOUT_SECONDS=45
