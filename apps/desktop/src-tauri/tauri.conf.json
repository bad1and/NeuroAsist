{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris",
  "version": "0.8.0",
  "identifier": "com.neuroasist.companion",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../../avatar-unity/Builds/NeuroAsistAvatar": "avatar"
    }
  }
}
