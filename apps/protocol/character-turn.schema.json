{
  "$defs": {
    "AffectCue": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "$ref": "#/$defs/Emotion",
          "default": "neutral"
        },
        "intensity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intensity",
          "type": "number"
        },
        "valence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Valence",
          "type": "number"
        },
        "arousal": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Arousal",
          "type": "number"
        }
      },
      "title": "AffectCue",
      "type": "object"
    },
    "ContinuityCue": {
      "additionalProperties": false,
      "properties": {
        "referenced_memory_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Referenced Memory Ids",
          "type": "array"
        },
        "referenced_episode_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Referenced Episode Ids",
          "type": "array"
        },
        "closes_open_loop_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Closes Open Loop Ids",
          "type": "array"
        }
      },
      "title": "ContinuityCue",
      "type": "object"
    },
    "DeliveryCue": {
      "additionalProperties": false,
      "properties": {
        "pace": {
          "default": "normal",
          "pattern": "^(slow|normal|fast)$",
          "title": "Pace",
          "type": "string"
        },
        "emphasis": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Emphasis",
          "type": "number"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/DeliveryOverride"
          },
          "maxItems": 3,
          "title": "Overrides",
          "type": "array"
        }
      },
      "title": "DeliveryCue",
      "type": "object"
    },
    "DeliveryOverride": {
      "additionalProperties": false,
      "description": "Restrained delivery change for one 1-based spoken sentence.",
      "properties": {
        "segment": {
          "maximum": 100,
          "minimum": 1,
          "title": "Segment",
          "type": "integer"
        },
        "pace": {
          "default": "normal",
          "pattern": "^(slow|normal|fast)$",
          "title": "Pace",
          "type": "string"
        },
        "speed": {
          "anyOf": [
            {
              "maximum": 1.3,
              "minimum": 0.7,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional pitch-preserving speed multiplier for this sentence (0.70–1.30).",
          "title": "Speed"
        },
        "emphasis": {
          "default": "none",
          "pattern": "^(none|light)$",
          "title": "Emphasis",
          "type": "string"
        }
      },
      "required": [
        "segment"
      ],
      "title": "DeliveryOverride",
      "type": "object"
    },
    "Emotion": {
      "enum": [
        "neutral",
        "happy",
        "sad",
        "angry",
        "annoyed",
        "smirk",
        "thinking",
        "surprised",
        "embarrassed",
        "concerned"
      ],
      "title": "Emotion",
      "type": "string"
    },
    "Gesture": {
      "enum": [
        "none",
        "auto",
        "talk",
        "greeting",
        "agreement",
        "disagreement",
        "question",
        "explanation",
        "thinking",
        "surprise",
        "frustration",
        "farewell",
        "shrug"
      ],
      "title": "Gesture",
      "type": "string"
    },
    "GestureCue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Gesture",
          "default": "auto"
        },
        "intensity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intensity",
          "type": "number"
        },
        "interrupt": {
          "default": true,
          "title": "Interrupt",
          "type": "boolean"
        }
      },
      "title": "GestureCue",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "casual_chat",
        "question",
        "task_request",
        "unknown"
      ],
      "title": "Intent",
      "type": "string"
    },
    "MemoryCandidate": {
      "additionalProperties": false,
      "description": "A proposed memory, never a direct command to mutate storage.",
      "properties": {
        "kind": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "default": "user",
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "value_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value Text",
          "type": "string"
        },
        "importance": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Importance",
          "type": "number"
        },
        "confidence": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "sensitivity": {
          "default": "normal",
          "pattern": "^(normal|sensitive)$",
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "predicate",
        "value_text"
      ],
      "title": "MemoryCandidate",
      "type": "object"
    },
    "MemoryDecisionCue": {
      "additionalProperties": false,
      "description": "Optional model assessment; MemoryService remains the authority.",
      "properties": {
        "action": {
          "pattern": "^(accept|reject|clarify)$",
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "clarification_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Id"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "MemoryDecisionCue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical visible reply plus non-visible character metadata.",
  "properties": {
    "protocol_version": {
      "default": 3,
      "title": "Protocol Version",
      "type": "integer"
    },
    "reply": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Reply",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/Intent",
      "default": "unknown"
    },
    "affect": {
      "$ref": "#/$defs/AffectCue"
    },
    "gesture": {
      "$ref": "#/$defs/GestureCue"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryCue"
    },
    "continuity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContinuityCue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "memory_candidates": {
      "items": {
        "$ref": "#/$defs/MemoryCandidate"
      },
      "maxItems": 3,
      "title": "Memory Candidates",
      "type": "array"
    },
    "memory_decisions": {
      "items": {
        "$ref": "#/$defs/MemoryDecisionCue"
      },
      "maxItems": 3,
      "title": "Memory Decisions",
      "type": "array"
    }
  },
  "required": [
    "reply"
  ],
  "title": "Character Protocol v3",
  "type": "object",
  "$id": "https://neuroasist.local/schemas/character-turn-v3.json"
}
